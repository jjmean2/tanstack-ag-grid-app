# Prettier also skips what .gitignore lists (node_modules, dist, .tanstack, ...).
# Below: files that tools write or that come from elsewhere. Reformatting them
# only produces churn the next time the tool rewrites them.

# Lock files
package-lock.json
pnpm-lock.yaml
yarn.lock
skills-lock.json

# Generated code
**/routeTree.gen.ts
**/next-env.d.ts
**/.next/

# Agent skills installed from upstream (tracked by skills-lock.json);
# .claude/skills links to them.
.agents/
.claude/skills/

# Written by CLIs: project scaffolder metadata, MCP server list
**/.cta.json
.mcp.json

# Backup of the old dev container setup (with its lock file)
.devcontainer.bak/
