{
  "name": "@lab/workbook",
  "version": "0.0.0",
  "private": true,
  "description": "Spreadsheet-like forms over a client state: typed cells, fixed formulas, grid and form sheets, links across screens.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./ag-grid": "./src/ag-grid/index.ts",
    "./ag-grid/styles.css": "./src/ag-grid/styles.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ag-grid-community": ">=36.2.0",
    "ag-grid-react": ">=36.2.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "ag-grid-community": {
      "optional": true
    },
    "ag-grid-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "jsdom": "^30.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  }
